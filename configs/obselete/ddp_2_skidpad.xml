<config>
  <settings dt='0.01'>
    <experiment_type>Simulation</experiment_type>
  </settings>

  <track radius='3.0'>skidpad</track>

  <extensions>
      <extension handle='laptimer'>Laptimer</extension>
        <!-- <extension handle='logger'>Logger</extension> -->
        <!-- <extension handle='snapshot'>SnapshotSaver</extension> -->
      <extension handle='visualization' car_graphics='True'>Visualization</extension>
        <extension handle='gifsaver'>Gifsaver</extension>
      <extension handle='simulator' match_time='True'>KinematicBicycleCurvilinearSimulator</extension>
  </extensions>

  <cars>
    <car>
      <name>Red Porsche</name>
      <hardware>Offboard</hardware>
      <config_name>audi_11</config_name>
      <init_states>(3.0,0.0, radians(90), 1.1)</init_states>
      <controller>
        <type>DdpPointMassCarController</type>
      </controller>
    </car>

    <car>
      <name>Green Porsche</name>
      <hardware>Offboard</hardware>
      <config_name>audi_12</config_name>
      <init_states>(3.2,0.2, radians(90), 1.0)</init_states>
      <controller>
        <type>DdpPointMassCarController</type>
      </controller>
    </car>

  </cars>
</config>
