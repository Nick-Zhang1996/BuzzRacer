<config>
  <settings dt='0.01' multiprocess='True'>
      <!-- Not checked, determined by if simulator or optitrack is initiated -->
      <experiment_type>Simulation</experiment_type>
  </settings>

  <track>saved</track>

  <extensions>
      <extension handle='laptimer'>Laptimer</extension>
      <!--<extension handle='logger'>Logger</extension>-->
      <extension handle='planner'>GameTheoreticPlanner</extension>
      <!--<extension handle='vi'>Optitrack</extension>-->
      <extension handle='visualization' show_car_info='False'>VisualizationGL</extension>
      <!-- <extension handle='step_counter' total_count='1000'>StepCounter</extension>-->
      <extension handle='simulator' match_time='True'>DynamicBicycleCartesianSimulator</extension>
      <extension>Gifsaver</extension>
  </extensions>

  <cars>
    <car>
      <name>audi_11</name>
      <hardware>Offboard</hardware>
      <config_name>audi_11</config_name>
      <controller max_speed='0.3' planner='True'>
        <type>StanleyController</type>
        <init_states>curv(0.2, 0.05, -0.1, 0.2)</init_states>
      </controller>
    </car>


    <car>
      <name>audi_12</name>
      <hardware>Offboard</hardware>
      <config_name>audi_12</config_name>
      <controller max_speed='0.5' planner='True'>
        <type>StanleyController</type>
        <!-- <init_states>(1.88333728,0.47559478, -3.01720037, 1.0)</init_states> -->
        <init_states>curv(0.3, -0.15, -0.3, 0.2)</init_states>
      </controller>
    </car>

    <car>
      <name>lambo_13</name>
      <hardware>Offboard</hardware>
      <config_name>lambo_13</config_name>
      <controller max_speed='0.4' planner='True'>
        <type>StanleyController</type>
        <init_states>curv(0.6, 0.05, -0.1, 0.2)</init_states>
      </controller>
    </car>

    <car>
      <name>porsche_16</name>
      <hardware>Offboard</hardware>
      <config_name>porsche_16</config_name>
      <controller max_speed='0.5' planner='True'>
        <type>StanleyController</type>
        <init_states>curv(0.6, -0.15, -0.3, 0.2)</init_states>
      </controller>
    </car>

    <car>
      <name>corvette_17</name>
      <hardware>FHSS</hardware>
      <config_name>corvette_17</config_name>
      <controller max_speed='0.3' planner='True'>
        <type>StanleyController</type>
        <init_states>curv(3.1, 0.05, -0.1, 0.2)</init_states>
      </controller>
    </car>

    <car>
      <name>porsche_18</name>
      <hardware>FHSS</hardware>
      <config_name>porsche_18</config_name>
      <controller max_speed='0.3' planner='True'>
        <type>StanleyController</type>
        <init_states>curv(3.0, -0.15, -0.3, 0.2)</init_states>
      </controller>
    </car>

    <car>
      <name>mclaren_21</name>
      <hardware>FHSS</hardware>
      <config_name>mclaren_21</config_name>
      <controller max_speed='0.5' planner='True'>
        <type>StanleyController</type>
        <init_states>curv(5.4, 0.05, -0.1, 0.2)</init_states>
      </controller>
    </car>

    <car>
      <name>mclaren_22</name>
      <hardware>FHSS</hardware>
      <config_name>mclaren_22</config_name>
      <controller max_speed='0.4' planner='True'>
        <type>StanleyController</type>
        <init_states>curv(5.3, -0.15, -0.3, 0.2)</init_states>
      </controller>
    </car>

  </cars>
</config>
