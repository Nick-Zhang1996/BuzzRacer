<config>
  <settings dt='0.01'>
    <experiment_type>Simulation</experiment_type>
  </settings>

  <track>saved</track>

  <extensions>
      <extension handle='laptimer'>Laptimer</extension>
      <extension handle='logger'>Logger</extension>
      <extension handle='visualization'>VisualizationGL</extension>
      <extension handle='simulator' match_time='True'>DynamicBicycleCartesianSimulator</extension>
      <!-- <extension handle='snapshot'>SnapshotSaver</extension> -->
    <extension>Gifsaver</extension>
  </extensions>

  <cars>
    <car>
      <name>Red Porsche</name>
      <hardware>Offboard</hardware>
      <config_name>audi_11</config_name>
      <controller max_speed='2.0'>
        <type>StanleyController</type>
        <init_states>(3.2*0.6,2.1*0.6, radians(-90), 1.0)</init_states>
      </controller>
    </car>

  </cars>
</config>
