<config>
  <settings dt='0.01'>
      <!-- Not checked, determined by if simulator or optitrack is initiated -->
      <experiment_type>RealWorld</experiment_type>
  </settings>

  <track>saved</track>

  <extensions>
      <extension handle='laptimer'>Laptimer</extension>
      <!--<extension handle='logger'>Logger</extension>-->
        <!-- <extension handle='snapshot'>SnapshotSaver</extension> -->
      <extension handle='vi'>Optitrack</extension>
      <extension handle='visualization' show_car_info='False'>VisualizationGL</extension>
      <!-- <extension handle='step_counter' total_count='1000'>StepCounter</extension>-->
      <!--<extension handle='simulator' match_time='False'>DynamicBicycleCartesianSimulator</extension> -->
  </extensions>

  <cars>
    <car>
      <name>Audi_11</name>
      <hardware>Offboard</hardware>
      <config_name>audi_11</config_name>
      <controller max_speed='1.0'>
        <type>StanleyCarController</type>
        <init_states>(3.2*0.6,2.4*0.6, radians(-90), 1.0)</init_states>
      </controller>
    </car>

    <car>
      <name>Audi_12</name>
      <hardware>Offboard</hardware>
      <config_name>audi_12</config_name>
      <controller max_speed='1.0'>
        <type>StanleyCarController</type>
        <init_states>(3.4*0.6,3.0*0.6, radians(-90), 1.0)</init_states>
      </controller>
    </car>

    <car>
      <name>Porsche_16</name>
      <hardware>Offboard</hardware>
      <config_name>porsche_16</config_name>
      <controller max_speed='1.0'>
        <type>StanleyCarController</type>
        <init_states>(3.1*0.6,3.4*0.6, radians(-90), 1.0)</init_states>
      </controller>
    </car>

    <car>
      <name>Lambo_13</name>
      <hardware>Offboard</hardware>
      <config_name>lambo_13</config_name>
      <controller max_speed='1.0'>
        <type>StanleyCarController</type>
        <init_states>(3.2*0.6,4.0*0.6, radians(-90), 1.0)</init_states>
      </controller>
    </car>

  </cars>
</config>
