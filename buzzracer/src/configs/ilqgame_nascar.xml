<config>
  <settings dt='0.01'>
    <experiment_type>Simulation</experiment_type>
  </settings>

    <!--<track radius='2.0' length='2.0' width='0.6' resolution='100'>nascar</track>-->
    <track>nascar</track>

  <extensions>
      <extension handle='laptimer'>Laptimer</extension>
      <extension handle='logger'>Logger</extension>
      <extension handle='snapshot'>SnapshotSaver</extension>
      <extension handle='visualization' car_graphics='True'>Visualization</extension>
      <extension handle='simulator' match_time='True'>CurvilinearSimulator</extension>
          <!--<extension handle='gifsaver'>Gifsaver</extension>-->
  </extensions>

  <cars>
    <car>
      <name>Red Porsche</name>
      <hardware>Offboard</hardware>
      <config_name>sim_red</config_name>
      <init_states>(0.2,-0.1, radians(0), 3)</init_states>
      <controller>
        <type>EmptyCarController</type>
      </controller>
    </car>

    <car>
      <name>Green Porsche</name>
      <hardware>Offboard</hardware>
      <config_name>sim_green</config_name>
      <init_states>(0.4,0.1, radians(0), 3)</init_states>
      <controller 
        control_opponent='True'
        blocking_control='False'
        >
        <type>iLQGameCarController</type>
      </controller>
    </car>

  </cars>
</config>
