<config>
  <settings dt='0.01'>
    <experiment_type>Realworld</experiment_type>
  </settings>

  <track>saved</track>

  <extensions>
      <extension handle='laptimer'>Laptimer</extension>
      <!--<extension handle='logger'>Logger</extension>-->
        <!-- <extension handle='snapshot'>SnapshotSaver</extension> -->
      <extension handle='visualization' car_graphics='True'>Visualization</extension>
        <!--<extension handle='simulator' match_time='False'>KinematicSimulator</extension>-->
          <!--<extension handle='lap_counter' lap_count='0'>LapCounter</extension>-->
      <extension handle='vi'>Optitrack</extension>
        <!-- <extension handle='gifsaver'>Gifsaver</extension> -->
  </extensions>

  <cars>
    <car>
      <name>Red Porsche</name>
      <hardware>Offboard</hardware>
      <config_name>audi_13</config_name>
      <init_states>(3.7*0.6,3.0*0.6, radians(-90), 2.1)</init_states>
      <controller
        max_speed='3.0'
        >
        <type>StanleyCarController</type>
        <planner 
          skip_count='3'
          debug='False'
          control_opponent='True' 
          blocking_control='False'
          iterations='1'
          horizon='14'
          Q1='np.diag(  [ 0,0.00,30.0,3.0])'
          q1='np.array([[-0.01,-0.1,0,0]]).T'
          Q2='np.diag(  [ 0,0.00,30.0,3.0])'
          q2='np.array([[-0.01,-0.1,0,0]]).T'
          Kcol='0'
          boundary_min_distance='0.03'
          >iLQGamePlanner</planner>
      </controller>
    </car>

    <car>
      <name>Green Porsche</name>
      <hardware>Offboard</hardware>
      <config_name>audi_11</config_name>
      <init_states>(3.9*0.6,3.3*0.6, radians(-90), 2.0)</init_states>
      <controller
        max_speed='2.0'
        >
        <type>StanleyCarController</type>
        <planner>Planner</planner>
      </controller>
    </car>

  </cars>
</config>
