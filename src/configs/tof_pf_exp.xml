<config>
  <settings dt='0.01'>
    <experiment_type>Realworld</experiment_type>
  </settings>

  <track>saved</track>

  <extensions>
      <extension handle='laptimer'>Laptimer</extension>

      <extension handle='visualization' car_graphics='True'>Visualization</extension>

      <extension handle='logger'>Logger</extension>
      <extension handle='snapshot'>SnapshotSaver</extension>
      <extension handle='gifsaver'>Gifsaver</extension>
      
      <extension handle='tof_stream' max_range='500' simulate_tof='True'>TofSensorStream</extension>
      <extension handle='tof_simulator' simulate_tof='True' write_measurement='False'>TofSensorSimulation</extension>
      <extension handle='tof_pf'>TofLocalizationPf</extension>
  </extensions>

  <cars>
    <car>
      <name>2002 toyota corolla 3 previous owners 4 accidents rebuilt title $7000 obo</name>
      <hardware>Offboard</hardware>
      <config_name>amz_lidar</config_name>
      <controller max_speed='0' horizon='30'>
        <type>StanleyCarController</type>
        <init_states>(0.5*0.6,0.5*0.6, radians(90), 0.5)</init_states>
      </controller>
    </car>

  </cars>
</config>
