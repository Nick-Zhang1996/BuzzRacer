    </car>

    <car>
      <name>Green Porsche</name>
      <hardware>Offboard</hardware>
      <config_name>sim_green</config_name>
      <init_states>(-0.9688108990343572, -8.367894567421548, 2.142545411076302, 3.620019383831832)</init_states>
