    </car>

    <car>
      <name>Green Porsche</name>
      <hardware>Offboard</hardware>
      <config_name>sim_green</config_name>
      <init_states>(-0.6556235715502855, -8.39361697324821, 2.1719087393203784, 2.808437650824679)</init_states>
      <controller horizon="20" samples_count="1024">
        <type>MppiFrenetCarController</type>
      </controller>
    </car>

  </cars>

</config>