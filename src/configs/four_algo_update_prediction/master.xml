<config>
  <settings dt='0.01'>
    <experiment_type>Simulation</experiment_type>
  </settings>

  <track>sine</track>

  <extensions>
      <extension handle='laptimer'>Laptimer</extension>
      <extension handle='logger'>Logger</extension>
      <extension handle='snapshot'>SnapshotSaver</extension>
      <extension handle='visualization' car_graphics='False'>FakeVisualization</extension>
      <extension handle='simulator' match_time='True'>KinematicBicycleFrenetSimulator</extension>
      <extension handle='boundary_checker'>BoundaryChecker</extension>
      <extension handle='collision_checker'>OpponentCollisionChecker</extension>
      <extension handle='lap_counter' lap_count='1'>LapCounter</extension>
      <extension handle='config_logger'>ConfigLogger</extension>
      <extension handle='watchdog'>Watchdog</extension>
  </extensions>

  <cars>
    <car>
      <name>Red Porsche</name>
      <hardware>Offboard</hardware>
      <config_name>sim_green</config_name>
      <init_states>(0.2,0.1, radians(0), 3)</init_states>
      <controller>
        <type>EmptyCarController</type>
      </controller>
    </car>

    <car>
      <name>Green Porsche</name>
      <hardware>Offboard</hardware>
      <config_name>sim_green</config_name>
      <init_states>(0.6,-0.1, radians(0), 2)</init_states>
      <controller>
        <type>EmptyCarController</type>
      </controller>
    </car>

  </cars>

</config>
